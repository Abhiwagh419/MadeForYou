{
  "name": "@madeforyou/studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build && node scripts/finalize-headers.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf:dev": "node scripts/prepare-wrangler.mjs && pnpm build && wrangler pages dev dist",
    "cf:deploy": "node scripts/prepare-wrangler.mjs --deploy && wrangler d1 migrations apply madeforyou --remote && pnpm build && wrangler pages deploy dist --project-name madeforyou --branch main",
    "mailer:deploy": "wrangler deploy --config ../../workers/mailer/wrangler.toml",
    "mailer:secret": "wrangler secret put CRON_SECRET --config ../../workers/mailer/wrangler.toml"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.12",
    "@madeforyou/api": "workspace:*",
    "@madeforyou/renderer": "workspace:*",
    "@madeforyou/schema": "workspace:*",
    "@madeforyou/templates": "workspace:*",
    "@madeforyou/ui": "workspace:*",
    "hono": "^4.13.19",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@madeforyou/api": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.4",
    "wrangler": "^4.165.0"
  }
}
