{
  "name": "@madeforyou/studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf:dev": "node scripts/prepare-wrangler.mjs && pnpm build && wrangler pages dev dist",
    "cf:deploy": "node scripts/prepare-wrangler.mjs && pnpm build && wrangler pages deploy dist --project-name madeforyou --branch main"
  },
  "dependencies": {
    "@madeforyou/renderer": "workspace:*",
    "@madeforyou/schema": "workspace:*",
    "@madeforyou/templates": "workspace:*",
    "@madeforyou/ui": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "hono": "^4.6.0",
    "@clerk/clerk-react": "^5.0.0",
    "@madeforyou/api": "workspace:*"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0",
    "@madeforyou/api": "workspace:*"
  }
}
